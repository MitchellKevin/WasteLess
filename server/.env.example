PORT=5000
# Local MongoDB for development. In production (Render) use your MongoDB Atlas connection string:
#   mongodb+srv://<user>:<password>@wasteless.0hinhda.mongodb.net/?appName=WasteLess
# Special characters in the password (@ : / ? # % etc.) must be URL-encoded.
MONGODB_URI=mongodb://localhost:27017/wasteless
# Database name inside the cluster (default: wasteless)
MONGODB_DB=wasteless
# Long random string, e.g. from: openssl rand -hex 32
JWT_SECRET=change_this_to_a_long_random_string

# RevenueCat (WasteLess Plus in the App Store / Google Play)
# Secret API key (Project settings → API keys → Secret), used to check a user's subscription
REVENUECAT_SECRET_KEY=
# Any long random string; paste the same value as the webhook's Authorization header in RevenueCat
REVENUECAT_WEBHOOK_AUTH=
# Entitlement identifier configured in RevenueCat
REVENUECAT_ENTITLEMENT=plus

# Email for "forgot password" (any SMTP provider: Gmail app password, Brevo, Resend, SendGrid, …).
# Without SMTP_HOST, development prints the email in the terminal instead of sending it.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="WasteLess <no-reply@example.com>"
# Address of the web app, used in the reset link (on Render: https://wasteless-i00n.onrender.com)
APP_URL=http://localhost:5173
