# Copy to .env.app and fill in before building the iOS/Android app (npm run build:app / release:android).
# The website doesn't use these: it always talks to the server it is served from.

# Your API on Render, without a trailing slash. The app has no server of its own.
VITE_API_URL=https://wasteless-i00n.onrender.com

# RevenueCat public SDK keys (Project settings → API keys). Safe to ship in the app.
VITE_REVENUECAT_IOS_KEY=appl_xxxxxxxx
VITE_REVENUECAT_ANDROID_KEY=goog_xxxxxxxx

# Optional: shown on the web version so people can get the app
VITE_APP_STORE_URL=
VITE_PLAY_STORE_URL=
